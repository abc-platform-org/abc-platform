{
  "contract_id": "abc.internal.eng05.decision.v2.draft",
  "engine_id": "ENG-05",
  "role": "DECISION_INTELLIGENCE",
  "status": "CONTRACT_DRAFT_NO_RUNTIME_RELEASE",
  "upstream": [
    "ENG-04",
    "ENG-14"
  ],
  "downstream": [
    "AI_STUDIO_LOOK_LOCK",
    "ENG-06"
  ],
  "errors": [
    "INVALID_CONTEXT",
    "PROVENANCE_MISMATCH",
    "UNREVIEWED_KNOWLEDGE",
    "CRITICAL_EVIDENCE_MISSING",
    "ENG14_POLICY_BLOCK",
    "NOT_IMPLEMENTED"
  ],
  "request_payload_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "service_kind",
      "recommendation_ref",
      "candidate_looks",
      "knowledge_sources",
      "critical_unknowns",
      "policy_gate"
    ],
    "properties": {
      "service_kind": {
        "enum": [
          "HAIRCUT",
          "HAIR_COLOR",
          "BEARD",
          "MAKEUP",
          "NAILS",
          "SKIN",
          "EXTENSIONS",
          "KERATIN",
          "CORRECTIVE"
        ]
      },
      "recommendation_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine_id",
          "session_id",
          "tenant_id",
          "branch_id",
          "digest"
        ],
        "properties": {
          "engine_id": {
            "const": "ENG-04"
          },
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96
          },
          "branch_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "candidate_looks": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "look_id",
            "spec_digest",
            "evidence_ids"
          ],
          "properties": {
            "look_id": {
              "type": "string",
              "format": "uuid"
            },
            "spec_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "knowledge_sources": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_ref",
            "version",
            "digest",
            "review_status"
          ],
          "properties": {
            "source_ref": {
              "type": "string",
              "pattern": "^synthetic:[a-z0-9-]{3,64}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "review_status": {
              "enum": [
                "UNVERIFIED",
                "SPECIALIST_REVIEWED"
              ]
            }
          }
        }
      },
      "critical_unknowns": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        }
      },
      "policy_gate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine_id",
          "decision",
          "decision_digest"
        ],
        "properties": {
          "engine_id": {
            "const": "ENG-14"
          },
          "decision": {
            "enum": [
              "BLOCK",
              "REVIEW_REQUIRED"
            ]
          },
          "decision_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "response_result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "status",
      "eligible_looks",
      "excluded_looks",
      "critical_unknowns",
      "specialist_selection_authorized",
      "execution_authorized"
    ],
    "properties": {
      "status": {
        "enum": [
          "BLOCKED",
          "SPECIALIST_REVIEW_REQUIRED"
        ]
      },
      "eligible_looks": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "look_id",
            "reason",
            "evidence_ids"
          ],
          "properties": {
            "look_id": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "excluded_looks": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "look_id",
            "reason"
          ],
          "properties": {
            "look_id": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            }
          }
        }
      },
      "critical_unknowns": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        }
      },
      "specialist_selection_authorized": {
        "const": false
      },
      "execution_authorized": {
        "const": false
      }
    }
  }
}
