{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abc.internal/v1/consultation-profile.schema.json",
  "title": "consultation-profile",
  "type": "object",
  "required": [
    "session_id",
    "service_id",
    "question_profile_version",
    "answer_ids",
    "evidence_ids",
    "readiness",
    "updated_at"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "question_profile_version": {
      "type": "string",
      "minLength": 1
    },
    "answer_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "readiness": {
      "type": "string",
      "enum": [
        "NEEDS_QUESTIONS",
        "READY_FOR_RECOMMENDATION",
        "PROFESSIONAL_CHECK_REQUIRED",
        "SAFETY_BLOCKED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "critical_unknown_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "client_goal": {
      "type": "string",
      "minLength": 1
    },
    "maintenance_preference": {
      "type": "string",
      "minLength": 1
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
