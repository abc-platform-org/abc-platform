{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ABC ENG-05 Independent Specialist Detached Attestation V1",
  "description": "Requires external credential issuer and trust anchor; CI keys never confer production clearance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "source_sha256",
    "reviewer_id",
    "credential_id",
    "issued_at",
    "decision",
    "reviewed_claim_ids",
    "conflict_of_interest",
    "signature_alg",
    "signature_b64"
  ],
  "properties": {
    "contract": {
      "const": "abc.eng05.specialist-review.v1.review"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "credential_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT",
        "REQUEST_REVISION"
      ]
    },
    "reviewed_claim_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "conflict_of_interest": {
      "const": false
    },
    "signature_alg": {
      "const": "Ed25519"
    },
    "signature_b64": {
      "type": "string",
      "minLength": 80,
      "maxLength": 256
    }
  }
}
