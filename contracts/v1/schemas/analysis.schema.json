{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abc.internal/v1/analysis.schema.json",
  "title": "analysis",
  "description": "Draft Phase-02 interface. No runtime claim.",
  "type": "object",
  "required": [
    "analysis_id",
    "session_id",
    "service_id",
    "engine_version",
    "evidence_ids",
    "attributes",
    "unknowns",
    "created_at"
  ],
  "properties": {
    "analysis_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "value",
          "evidence_class"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "evidence_class": {
            "$ref": "common.schema.json#/$defs/evidenceClass"
          },
          "source_evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "safety_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "service_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "additionalProperties": false
}
