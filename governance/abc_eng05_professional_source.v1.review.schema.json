{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ABC ENG-05 Professional Source Candidate V1 — review only",
  "description": "Schema compliance does not constitute specialist, credential or professional approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "source_id",
    "version",
    "source_type",
    "publisher_id",
    "submitted_by",
    "scope",
    "jurisdiction",
    "publication_ref",
    "published_at",
    "expires_at",
    "license_ref",
    "content_sha256",
    "claims"
  ],
  "properties": {
    "contract": {
      "const": "abc.eng05.professional-source.v1.review"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{5,95}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "source_type": {
      "enum": [
        "PEER_REVIEWED_RESEARCH",
        "MANUFACTURER_PROTOCOL",
        "PROFESSIONAL_GUIDELINE",
        "LICENSED_TRAINING_MANUAL",
        "CI_SYNTHETIC_FIXTURE"
      ]
    },
    "publisher_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "submitted_by": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "scope": {
      "enum": [
        "HAIRCUT",
        "HAIR_COLOR",
        "BEARD",
        "SKIN_BEAUTY",
        "MAKEUP",
        "NAILS",
        "EXTENSIONS",
        "BRIDAL"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "publication_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "license_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "topic",
          "applicability",
          "assertion",
          "evidence_ref",
          "evidence_sha256",
          "evidence_strength",
          "safety_critical",
          "uncertainty"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          },
          "topic": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          },
          "applicability": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          },
          "assertion": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_strength": {
            "enum": [
              "LOW",
              "MODERATE",
              "HIGH",
              "UNKNOWN"
            ]
          },
          "safety_critical": {
            "type": "boolean"
          },
          "uncertainty": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "CONTEXT_MISSING",
                "EVIDENCE_LIMITED",
                "NOT_GENERALIZABLE",
                "CONTRAINDICATION_UNKNOWN"
              ]
            }
          }
        }
      }
    }
  }
}
