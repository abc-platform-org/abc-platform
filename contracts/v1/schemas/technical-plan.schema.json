{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abc.internal/v1/technical-plan.schema.json",
  "title": "technical-plan",
  "type": "object",
  "required": [
    "plan_id",
    "session_id",
    "service_id",
    "selected_look_version_id",
    "plan_version",
    "status",
    "feasibility_assessment_id",
    "evidence_ids",
    "blocking_unknowns",
    "steps",
    "created_at"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_look_version_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "AWAITING_SPECIALIST_INPUT",
        "REQUIRES_REVIEW",
        "CONDITIONALLY_VALIDATED",
        "VALIDATED",
        "INVALIDATED",
        "REJECTED"
      ]
    },
    "feasibility_assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "sop_version_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blocking_unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "phase",
          "objective",
          "requires_evidence_keys",
          "state"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "requires_evidence_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "state": {
            "type": "string",
            "enum": [
              "PROPOSED",
              "CONDITIONAL",
              "PROHIBITED_UNTIL_VALIDATED"
            ]
          },
          "protocol_step_ref": {
            "type": "string",
            "minLength": 1
          },
          "tool_categories": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "value",
                "source_ref"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "manufacturer_protocol_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "quality_checkpoints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aftercare": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_engine_version": {
      "type": "string",
      "minLength": 1
    },
    "validation_id": {
      "type": "string",
      "minLength": 1
    },
    "validated_at": {
      "type": "string",
      "format": "date-time"
    },
    "validated_by_specialist_id": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "VALIDATED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "sop_version_id",
          "validation_id",
          "validated_by_specialist_id",
          "validated_at"
        ],
        "properties": {
          "blocking_unknowns": {
            "maxItems": 0
          },
          "steps": {
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "state": {
                  "enum": [
                    "PROPOSED",
                    "CONDITIONAL"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "CONDITIONALLY_VALIDATED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "sop_version_id",
          "validation_id",
          "validated_by_specialist_id",
          "validated_at"
        ]
      }
    }
  ]
}
