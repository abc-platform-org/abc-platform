{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abc.internal/v1/consent.schema.json",
  "title": "consent",
  "type": "object",
  "required": [
    "consent_id",
    "session_id",
    "client_id",
    "purpose",
    "status",
    "policy_version",
    "recorded_at",
    "recorded_by"
  ],
  "properties": {
    "consent_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "CAPTURE",
          "AI_PROCESSING",
          "PREVIEW_STORAGE",
          "INTERNAL_HANDOFF"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "WITHDRAWN",
        "EXPIRED"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_by": {
      "type": "string",
      "minLength": 1
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time"
    },
    "retention_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "IN_SALON_ACKNOWLEDGEMENT",
        "SIGNED_CONSENT"
      ]
    },
    "disclosure_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "WITHDRAWN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "withdrawn_at"
        ]
      }
    }
  ]
}
