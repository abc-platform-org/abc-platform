{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abc://contracts/engine19/handoff.v0.review",
  "title": "ABC 19-engine prospective handoff contract; validation does not authorize dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "contract_version",
    "from_engine",
    "to_engine",
    "tenant_id",
    "branch_id",
    "session_id",
    "state_version",
    "correlation_id",
    "artifact_kind",
    "artifact_sha256",
    "evidence_refs",
    "policy_proof_ref",
    "status",
    "execution_authorized",
    "customer_release_approved"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "format": "uuid"
    },
    "contract_version": {
      "const": "abc.internal.capability.v3.review"
    },
    "from_engine": {
      "type": "string",
      "pattern": "^ENG-(0[1-9]|1[0-9])$"
    },
    "to_engine": {
      "type": "string",
      "pattern": "^ENG-(0[1-9]|1[0-9])$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "branch_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "artifact_kind": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^[A-Z0-9_]+$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 256
      }
    },
    "policy_proof_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "status": {
      "const": "CANDIDATE_FOR_EXTERNAL_AUTHORIZATION"
    },
    "execution_authorized": {
      "const": false
    },
    "customer_release_approved": {
      "const": false
    }
  }
}
