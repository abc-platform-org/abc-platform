{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abc.internal/v1/evidence.schema.json",
  "title": "evidence",
  "description": "Draft Phase-02 interface. No runtime claim.",
  "type": "object",
  "required": [
    "evidence_id",
    "session_id",
    "service_id",
    "attribute_key",
    "evidence_class",
    "source_type",
    "captured_at"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attribute_key": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": [
        "string",
        "number",
        "boolean",
        "null",
        "object",
        "array"
      ]
    },
    "evidence_class": {
      "$ref": "common.schema.json#/$defs/evidenceClass"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "CLIENT_ANSWER",
        "SPECIALIST_OBSERVATION",
        "ASSET",
        "SALON_RECORD",
        "DERIVED_ANALYSIS",
        "NOT_AVAILABLE"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by_specialist_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "confidence_label": {
      "type": "string",
      "enum": [
        "UNRATED",
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "criticality": {
      "type": "string",
      "enum": [
        "OPTIONAL",
        "RECOMMENDATION_REQUIRED",
        "EXECUTION_REQUIRED"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "OBSERVED"
          }
        },
        "required": [
          "evidence_class"
        ]
      },
      "then": {
        "properties": {
          "source_type": {
            "enum": [
              "SPECIALIST_OBSERVATION",
              "ASSET"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "evidence_class"
        ]
      },
      "then": {
        "properties": {
          "source_type": {
            "const": "NOT_AVAILABLE"
          }
        }
      }
    }
  ]
}
