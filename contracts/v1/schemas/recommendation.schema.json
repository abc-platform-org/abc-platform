{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abc.internal/v1/recommendation.schema.json",
  "title": "recommendation",
  "type": "object",
  "required": [
    "recommendation_set_id",
    "session_id",
    "service_id",
    "candidates",
    "created_at"
  ],
  "properties": {
    "recommendation_set_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_engine_version": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "look_spec_id",
          "reason",
          "feasibility_label"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "look_spec_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "maintenance_tradeoffs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hard_filter_status": {
            "type": "string",
            "enum": [
              "PASSED",
              "CONDITIONALLY_PASSED"
            ]
          },
          "feasibility_label": {
            "type": "string",
            "enum": [
              "VISUALLY_PLAUSIBLE",
              "CONDITIONAL",
              "PROFESSIONAL_CHECK_REQUIRED"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "excluded_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "blocking_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
