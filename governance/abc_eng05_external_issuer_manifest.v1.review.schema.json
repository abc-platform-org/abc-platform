{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ABC ENG05 externally issued credential roster — review-only",
  "description": "The roster alone is not authority: verify signature with a separately provisioned and pinned root public key; never import trust from this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "issuer_id",
    "version",
    "issued_at",
    "expires_at",
    "jurisdiction",
    "credential_records",
    "revoked_credentials",
    "signature_alg",
    "signature_b64"
  ],
  "properties": {
    "contract": {
      "const": "abc.eng05.external-credential-issuer.v1.review"
    },
    "issuer_id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "jurisdiction": {
      "const": "EU"
    },
    "credential_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_id",
          "reviewer_id",
          "credential_status",
          "scopes",
          "jurisdiction",
          "valid_from",
          "valid_until",
          "reviewer_public_key_b64",
          "verification_ref",
          "independent_verifier_ref"
        ],
        "properties": {
          "credential_id": {
            "type": "string",
            "minLength": 4,
            "maxLength": 200
          },
          "reviewer_id": {
            "type": "string",
            "minLength": 4,
            "maxLength": 200
          },
          "credential_status": {
            "enum": [
              "VERIFIED",
              "REVOKED",
              "EXPIRED"
            ]
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "const": "HAIR_COLOR"
            }
          },
          "jurisdiction": {
            "const": "EU"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "reviewer_public_key_b64": {
            "type": "string",
            "minLength": 40,
            "maxLength": 80
          },
          "verification_ref": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "independent_verifier_ref": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "revoked_credentials": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 200
      }
    },
    "signature_alg": {
      "const": "Ed25519"
    },
    "signature_b64": {
      "type": "string",
      "minLength": 80,
      "maxLength": 256
    }
  }
}
