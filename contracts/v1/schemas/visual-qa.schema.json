{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abc.internal/v1/visual-qa.schema.json",
  "title": "visual-qa",
  "type": "object",
  "required": [
    "qa_report_id",
    "job_id",
    "look_version_id",
    "service_id",
    "qa_status",
    "region_fidelity",
    "identity_assessment",
    "evaluated_at",
    "evaluator_version"
  ],
  "properties": {
    "qa_report_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "look_version_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "qa_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INDETERMINATE"
      ]
    },
    "region_fidelity": {
      "type": "string",
      "enum": [
        "LOCKED_REGIONS_PRESERVED",
        "FAIL",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "identity_assessment": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "REQUIRES_HUMAN_REVIEW",
        "NOT_EVALUATED"
      ]
    },
    "reference_isolation": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_APPLICABLE",
        "NOT_EVALUATED"
      ]
    },
    "boundary_naturalness": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "REQUIRES_HUMAN_REVIEW",
        "NOT_EVALUATED"
      ]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "failed_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "human_review_required": {
      "type": "boolean"
    },
    "human_review_completed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "qa_status": {
            "const": "PASS"
          }
        },
        "required": [
          "qa_status"
        ]
      },
      "then": {
        "properties": {
          "region_fidelity": {
            "enum": [
              "LOCKED_REGIONS_PRESERVED",
              "NOT_APPLICABLE"
            ]
          },
          "identity_assessment": {
            "const": "PASS"
          }
        }
      }
    }
  ]
}
