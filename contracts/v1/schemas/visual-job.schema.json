{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abc.internal/v1/visual-job.schema.json",
  "title": "visual-job",
  "type": "object",
  "required": [
    "job_id",
    "session_id",
    "look_version_id",
    "source_asset_id",
    "mode",
    "state",
    "idempotency_key",
    "attempt",
    "created_at",
    "requested_by"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "look_version_id": {
      "type": "string",
      "minLength": 1
    },
    "source_asset_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_asset_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "TRANSFORM",
        "TRY_ON",
        "INSPIRATION"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "SUBMITTED",
        "VALIDATING_INPUT",
        "SEGMENTING",
        "GENERATING",
        "COMPOSITING",
        "QA_CHECKING",
        "QA_PASSED",
        "NEEDS_REVISION",
        "QA_FAILED",
        "CANCELLED",
        "RETRYABLE_FAILURE"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "model_adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "mask_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "original_image_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_asset_id": {
      "type": "string",
      "minLength": 1
    },
    "qa_report_id": {
      "type": "string",
      "minLength": 1
    },
    "failure_code": {
      "type": "string",
      "minLength": 1
    },
    "expected_session_version": {
      "type": "integer",
      "minimum": 0
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "QA_PASSED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "output_asset_id",
          "qa_report_id",
          "expected_session_version",
          "original_image_hash",
          "mask_policy_version"
        ]
      }
    }
  ]
}
