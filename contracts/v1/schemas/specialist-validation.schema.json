{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abc.internal/v1/specialist-validation.schema.json",
  "title": "specialist-validation",
  "type": "object",
  "required": [
    "validation_id",
    "session_id",
    "plan_id",
    "plan_version",
    "selected_look_version_id",
    "sop_version_id",
    "evidence_fingerprint",
    "specialist_id",
    "decision",
    "reviewed_at"
  ],
  "properties": {
    "validation_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "selected_look_version_id": {
      "type": "string",
      "minLength": 1
    },
    "sop_version_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "specialist_id": {
      "type": "string",
      "minLength": 1
    },
    "specialist_qualification_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "VALIDATED",
        "CONDITIONALLY_VALIDATED",
        "REJECTED",
        "NEEDS_REVISION",
        "INVALIDATED"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidated_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidated_reason": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "approval_proof_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "VALIDATED",
              "CONDITIONALLY_VALIDATED"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "specialist_qualification_id",
          "approval_proof_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "INVALIDATED"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "invalidated_at",
          "invalidated_reason"
        ]
      }
    }
  ]
}
